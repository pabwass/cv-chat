# Copiar a /opt/haven/.env y completar. Nunca subas el .env real a un repositorio.
SERVER_NAME=Mi comunidad
PUBLIC_URL=https://chat.example.com
# Tu usuario de Haven: la primera cuenta registrada con este nombre es la admin.
ADMIN_USERNAME=mi_usuario

# Puente Discord <-> Haven
# Canales de Discord a puentear (nombres o IDs separados por comas), o * para todos.
PUENTE_CANALES=*
# Cuentas de Haven sin vincular: marcar ("Nombre (Haven, sin verificar)") o bloquear (no salen a Discord).
PUENTE_SIN_VINCULAR=marcar
# vinculados = periodo de migracion: los canales de Discord solo se ven vinculando la cuenta,
# segun los permisos de Discord. Vacio = abierto.
PUENTE_ACCESO=vinculados
# Opcional: principio del nombre del canal contador de miembros de Discord.
PUENTE_CONTADOR_DISCORD=
# Opcional: 1 para registrar cuanto tarda en abrirse cada canal (tools/tiempos.log).
PUENTE_MEDIR=0

# Secreto OAuth2 de tu aplicacion de Discord (Developer Portal -> OAuth2).
# Guardalo con tools/guardar-secreto.sh para no escribirlo a mano.
DISCORD_CLIENT_SECRET=
# Opcional: titulo de la pestana del navegador en lugar de "Haven: <servidor>".
# Tambien es el nombre de la app instalable (Chrome > "Instalar app"), que usa
# el icono del servidor y los colores del tema Discord+, y el que se lee en Discord
# en "Nombre (<titulo>, sin verificar)".
PUENTE_TITULO=
# Opcional: firma de los mensajes de cuentas vinculadas en Discord, antes de la
# mencion. Puede llevar emojis del servidor como :nombre:. Por defecto: ✅ desde Haven
# "no" = sin linea de firma (conviene junto con PUENTE_MARCA).
PUENTE_FIRMA=
# Opcional: marca corta junto al nombre de las cuentas vinculadas en Discord, por
# ejemplo ✦ ("Ernesto ✦"). Solo texto o emojis comunes: Discord no muestra
# emojis del servidor en los nombres.
PUENTE_MARCA=
# Opcional: 1 = todos ven siempre el tema por defecto del servidor y no se puede
# elegir otro (se ocultan los selectores de temas). Ademas, las opciones de
# diseño de Configuracion (disposicion, densidad, zoom, iconos, imagenes...)
# quedan solo para los administradores: lo que elige un administrador se
# aplica a todos (por separado en la PC y en pantallas tactiles).
PUENTE_TEMA_FIJO=
# Opcional: canal que se abre al entrar por primera vez (despues, el ultimo que
# se abrio), en vez de la pantalla de bienvenida de Haven. Varios separados por
# comas: se usa el primero que la persona puede ver. Ejemplo: general,bienvenida
PUENTE_CANAL_INICIO=
